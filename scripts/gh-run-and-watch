#!/usr/bin/env python3
"""Trigger a GitHub Actions CI workflow and watch its progress."""

import argparse
import json
import subprocess
import time


def run(cmd: list[str], check: bool = True) -> str:
    """Run a command and return its stdout."""
    result = subprocess.run(cmd, capture_output=True, text=True, check=check)
    return result.stdout.strip()


def get_latest_run_id(workflow: str, branch: str) -> int | None:
    """Return the databaseId of the latest run, or None."""
    output = run(
        [
            "gh",
            "run",
            "list",
            "--workflow",
            workflow,
            "--branch",
            branch,
            "--limit",
            "1",
            "--json",
            "databaseId",
        ]
    )
    runs = json.loads(output)
    if runs:
        return runs[0]["databaseId"]
    return None


def main() -> None:
    """Trigger the CI workflow and watch the new run."""
    parser = argparse.ArgumentParser(
        description="Trigger a CI workflow and watch its progress."
    )
    parser.add_argument(
        "-b",
        "--branch",
        default=None,
        help="Branch to run the workflow on" " (default: current branch)",
    )
    parser.add_argument(
        "-w",
        "--workflow",
        default="ci.yml",
        help="Workflow file to run (default: ci.yml)",
    )
    args = parser.parse_args()

    branch = args.branch or run(["git", "rev-parse", "--abbrev-ref", "HEAD"])
    workflow = args.workflow
    print(f"Triggering CI workflow on branch: {branch}")

    old_run_id = get_latest_run_id(workflow, branch)
    run(["gh", "workflow", "run", workflow, "--ref", branch])

    print("Waiting for run to appear...")
    run_id = old_run_id
    for _ in range(20):
        run_id = get_latest_run_id(workflow, branch)
        if run_id != old_run_id:
            break
        time.sleep(0.5)
    if run_id == old_run_id:
        print("Timed out waiting for run to appear")
        raise SystemExit(1)
    print(f"Watching run {run_id}...")
    subprocess.run(["gh", "run", "watch", str(run_id)], check=True)


if __name__ == "__main__":
    main()
